# Application
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql+asyncpg://research_user:local_dev_password@localhost:5434/research_pipeline

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# LLM providers (at least one key is required unless USE_MOCK_LLM=1)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
TAVILY_API_KEY=
SERPAPI_API_KEY=
DEFAULT_LLM_MODEL=gpt-4o-mini
USE_MOCK_LLM=0

# Scraping and reports
REPORT_OUTPUT_DIR=/tmp/reports
SCRAPER_MAX_CONCURRENCY=10
SCRAPER_MAX_CONTENT_BYTES=2000000

# Demo data (local development only)
DEMO_SEED_ENABLED=true
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=DemoResearch123!
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=DemoAdmin123!
DEMO_VIEWER_EMAIL=viewer@example.com
DEMO_VIEWER_PASSWORD=DemoViewer123!
